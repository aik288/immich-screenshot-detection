# Immich Configuration
IMMICH_API_KEY=your-api-key-here
IMMICH_SERVER_URL=http://server-url:2283

# Optional: the API key already identifies the user
IMMICH_USER_ID=immich-user-uuid

# Optional: Docker network of your existing Immich stack
IMMICH_NETWORK=immich_default

# Screenshot Detection Settings
SCREENSHOT_CONFIDENCE_THRESHOLD=0.7
BATCH_SIZE=10
MAX_IMAGE_SIZE=2048

# Logging Settings
LOG_LEVEL=INFO

# Tag and Album Settings
SCREENSHOT_TAG=screenshot
CREATE_ALBUM=true
ALBUM_NAME=Screenshots
